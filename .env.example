# Razorpay test API credentials. Generate at https://dashboard.razorpay.com/app/keys
# while in Test Mode — keys begin with rzp_test_.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Master kill switch. Must be the literal string "true" to allow refunds.
# Set to anything else (or unset) to disable refunds globally.
REFUNDS_ENABLED=true

# HTTP port for the Express server (Railway sets this automatically).
PORT=3000
